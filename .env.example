# Copy to .env.local and fill in your own keys.
#   cp .env.example .env.local

# OpenRouter — used by /api/vision for the Gemma 4 vision model
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Moondream — used by /api/detect for shape bounding boxes
# https://moondream.ai
MOONDREAM_API_KEY=

# Cartesia — speech-to-text for the event log
CARTESIA_API_KEY=
